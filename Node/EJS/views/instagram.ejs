<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@<%= data.name %> • Instagram</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="bg-light">
    <div class="container my-5" style="max-width: 935px;">
        <div class="row align-items-center mb-5 border-bottom pb-4">
            <div class="col-md-4 text-center mb-3 mb-md-0">
                <div class="bg-secondary rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 150px; height: 150px; font-size: 3rem;">
                    <%= data.name.charAt(0).toUpperCase() %>
                </div>
            </div>
            <div class="col-md-8 text-center text-md-start">
                <div class="d-flex flex-column flex-md-row align-items-center mb-3">
                    <h2 class="fs-4 mb-2 mb-md-0 me-md-4 fw-normal">@<%= data.name %></h2>
                    <button class="btn btn-sm btn-primary fw-bold px-3">Follow</button>
                </div>
                <div class="d-flex justify-content-center justify-content-md-start gap-4 mb-2">
                    <div><span class="fw-bold"><%= data.posts.length %></span> posts</div>
                    <div><span class="fw-bold"><%= data.followers.toLocaleString() %></span> followers</div>
                    <div><span class="fw-bold"><%= data.following.toLocaleString() %></span> following</div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <% for(let post of data.posts){ %>
                <div class="col-4">
                    <div class="position-relative overflow-hidden shadow-sm rounded ratio ratio-1x1 bg-dark custom-card">
                        <img src="<%= post.image %>" class="img-fluid object-fit-cover w-100 h-100" alt="Instagram Post">
                        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center opacity-0 bg-black bg-opacity-50 text-white custom-overlay" style="transition: opacity 0.2s ease;">
                            <span class="me-3">❤️ <%= post.likes %></span>
                            <span>💬 <%= post.comments %></span>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <%- include("includes/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/script.js"></script>
</body>

</html>
